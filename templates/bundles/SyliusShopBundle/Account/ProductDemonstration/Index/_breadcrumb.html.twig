{% import '@SyliusShop/Common/Macro/breadcrumb.html.twig' as breadcrumb %}

{% set breadcrumb = configuration.vars.breadcrumb|default(metadata.applicationName~'.ui.'~metadata.pluralName) %}
{% set breadcrumbs = [
    { label: 'sylius.ui.home'|trans, url: path('sylius_shop_homepage') },
    { label: 'sylius.ui.my_account'|trans, url: path('sylius_shop_account_dashboard') },
    { label: breadcrumb|trans },
] %}

{{ breadcrumb.crumble(breadcrumbs) }}
