<div class="ui grid">
    <div class="ten wide column">
        <div class="ui segment">
            <table class="ui very basic collapsing celled table">
                <thead>
                    <tr>
                        <th>{{ 'app.ui.property'|trans }}</th>
                        <th>{{ 'sylius.ui.value'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ 'sylius.ui.title'|trans }}</td>
                        <td>{{ resource.title }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'sylius.ui.description'|trans }}</td>
                        <td>{{ resource.description }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'app.ui.capacity'|trans }}</td>
                        <td>{{ resource.capacity }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'app.ui.featured'|trans }}</td>
                        <td>{{ resource.featured ? 'Yes' : 'No' }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'sylius.ui.status'|trans }}</td>
                        <td>{{ resource.status.value|capitalize }}</td>
                    </tr>
                    <tr>
                        <td>{{ 'sylius.ui.created_at'|trans }}</td>
                        <td>{{ resource.createdAt|format_datetime(pattern="MMM d Y") }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="six wide column">
        <div class="ui segment">
            {% include '@SyliusShop/Product/_box.html.twig' with {'product': resource.product } %}
        </div>
    </div>
</div>
